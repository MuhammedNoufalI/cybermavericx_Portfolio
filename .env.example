DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DBNAME"

# Admin login (no defaults — login is refused if unset)
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
# Signs the admin session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=""

# Telegram notifications (contact form + CV downloads)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# reCAPTCHA Enterprise (policy-based key, service account). Required in production:
# the contact form and CV download fail closed without it.
# Site key is per environment (production key on prod only). Baked in at build time.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_PROJECT_ID=""
# Absolute path to the service-account JSON, OUTSIDE the web root. Never commit it.
RECAPTCHA_CREDENTIALS_PATH=""
# Comma-separated; each also accepts its www. form and any subdomain.
RECAPTCHA_ALLOWED_HOSTNAMES="cybermavericx.com"
# Acceptance threshold. Start at 0.5; don't tune in the first 48h.
RECAPTCHA_MIN_SCORE="0.5"
# Action names (defaults shown). Used by both browser and server.
# NEXT_PUBLIC_RECAPTCHA_ACTION_CONTACT="submit_contact"
# NEXT_PUBLIC_RECAPTCHA_ACTION_CV="download_cv"

# Timezone for Telegram alerts and admin timestamps
# NOTIFY_TIMEZONE="Asia/Dubai"

# Per-IP limits in front of the billable assessment (defaults shown)
# RATE_LIMIT_PER_MINUTE="5"
# RATE_LIMIT_PER_HOUR="30"
