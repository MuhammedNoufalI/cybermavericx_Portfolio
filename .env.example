DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DBNAME"

# Admin login (no defaults — login is refused if unset)
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
# Signs the admin session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=""

# Telegram notifications (contact form + CV downloads)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# reCAPTCHA Enterprise — score-based key. Required in production
# (contact form and CV download are refused without it).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_PROJECT_ID=""
RECAPTCHA_API_KEY=""
RECAPTCHA_MIN_SCORE="0.5"
